# Environment Configuration Example
GEMINI_API_KEY=your_gemini_api_key_here
JOBS_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
JOBS_GROUP_CHAT_ID=-100xxxxxxxxxx
JOBS_THREAD_ID=1

# Gmail Integration (for monitoring employer replies via IMAP)
GMAIL_USER_EMAIL=your_email@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Jobs.cz Credentials (optional, for browser automation)
JOBS_CZ_EMAIL=your_email@example.com
JOBS_CZ_PASSWORD=your_jobs_cz_password_here
